# Flask web — auth + queue only.
# Copy to .env. Full descriptions: ENVIRONMENT.md
# Job secrets (OpenAI, Anthropic, Exact, Supabase) belong on the Celery worker:
#   env.celery.example
# Redis URLs: env.redis.example

# --- Auth (must match Edge FILE_EXTRACTOR_API_KEY) ---
FILE_EXTRACTOR_KEY=

# --- Queue (same values as Celery worker) ---
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
# REDIS_URL=

# --- Optional local run ---
# PORT=5000
# FLASK_DEBUG=false
