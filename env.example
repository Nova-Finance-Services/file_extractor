# File Extractor API Configuration

# API Key for authentication (required for /extract endpoint)
# If not set, authentication will be disabled
FILE_EXTRACTOR_KEY=your-secret-api-key-here

# Maximum file size in bytes (default: 50MB)
MAX_FILE_SIZE=52428800

# Request timeout in seconds (default: 30)
REQUEST_TIMEOUT=30

# Server port (default: 5000)
PORT=5000

# Celery / Redis (set on your Render worker service in the dashboard)
# REDIS_URL is usually set automatically when you attach a Render Redis instance.

CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
