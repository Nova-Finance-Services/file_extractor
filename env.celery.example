# Celery worker — job secrets live here, not on Flask.
# Start command (Render worker). Must be this exact module — not CELERY_BROKER_URL:
#   celery -A celery_app worker --loglevel=info --concurrency=2
# On boot the [tasks] list must include process_accounting_agent_job.
# Models, delays, file-size limits, and task timeouts are code constants
# (chatbot/config.py, provider/exact/const.py, r2r/config.py, fileExtraction/config.py).

# --- 1. Queue (same values as Flask) ---
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
# REDIS_URL=   # only needed if CELERY_BROKER_URL is unset (Render Redis add-on)

# --- 2. Auth (must match Flask + Edge FILE_EXTRACTOR_API_KEY) ---
FILE_EXTRACTOR_KEY=

# --- 3. Supabase ---
DEV_SUPABASE_FUNCTIONS_URL=https://your-dev-project.supabase.co
PROD_SUPABASE_FUNCTIONS_URL=https://your-prod-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# DEV_SUPABASE_SERVICE_ROLE_KEY=
# PROD_SUPABASE_SERVICE_ROLE_KEY=

# --- 4. LLM ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- 5. Exact Online ---
EXACT_API_BASE_URL=https://start.exactonline.nl/api
EXACT_CLIENT_ID=
EXACT_CLIENT_SECRET=
# EXACT_TOKEN_URL=

# --- 6. Optional ---
SPACE_OCR_KEY=
