# Redis connection only (set this on Flask AND Celery — not on the Redis server)
#
# Redis does not read OPENAI_API_KEY, Exact secrets, or FILE_EXTRACTOR_KEY.
# It is just the broker. On Render, attaching a Redis add-on injects REDIS_URL.
#
# If you run Redis yourself: redis-server (optional requirepass). Then put the
# client URL below on the web + worker services.

# Preferred. Flask and Celery both use this if set.
CELERY_BROKER_URL=redis://localhost:6379/0

# Fallback when CELERY_BROKER_URL is empty (Render Redis add-on name).
REDIS_URL=redis://localhost:6379/0

# Where Celery stores task results. Default = broker URL.
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Password example:
# CELERY_BROKER_URL=redis://:your-redis-password@localhost:6379/0
# REDIS_URL=redis://:your-redis-password@localhost:6379/0
# TLS example (Redis Cloud / some Render plans):
# REDIS_URL=rediss://:your-redis-password@hostname:6380/0
